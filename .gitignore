# =============================================================================
# OpenJade - Original game data and research
# =============================================================================

# Original game data, historical copies and generated reports are private.
/game/
/OLD-Archive/
/reports/*
!/reports/README.md

# Python cache
/src/__pycache__/
/tests/__pycache__/

# Do not publish extracted assets from any working directory.
*.bf
*.dat
*.mgm
*.dds
*.mft
*.big
*.fat
*.bik

# =============================================================================
# OpenJade Engine - Rust / Cargo
# =============================================================================

# Cargo build artifacts (debug, release, incremental builds)
/engine/target/

# Rust temporary backup files
*.rs.bk

# Engine-generated local data
/engine/.idea/
/engine/cache/
/engine/logs/
/engine/tmp/

# =============================================================================
# Generated binaries and temporary files
# =============================================================================

*.exe
*.dll
*.pdb
*.ilk
*.bak
*.log
# Local research scene packages contain extracted assets.
*.ojscene
